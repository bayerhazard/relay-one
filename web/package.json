    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
